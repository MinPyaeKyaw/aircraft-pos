              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pos-reports"
              ]
            },
            "description": "500 kg on board for a leg that burns 1987 kg. Check status after a few seconds: estimatedFuelAtArrivalKg -1487, lowFuelWarning true."
          }
        },
        {
          "name": "Low fuel status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.code === 200 ? pm.response.json() : {};",
                  "",
                  "if (body.status === 'CALCULATED') {",
                  "    pm.test('low fuel warning raised', () => pm.expect(body.lowFuelWarning).to.eql(true));",
                  "    pm.test('arrival fuel is -1487 kg', () => pm.expect(body.estimatedFuelAtArrivalKg).to.eql(-1487));",
                  "} else {",
                  "    // Still in flight through the pipeline. That is legitimate, but it must",
                  "    // be one of the two real intermediate states, not anything else.",
                  "    pm.test('is a valid intermediate state (404 or PARSED)', () => {",
                  "        pm.expect([404, 200]).to.include(pm.response.code);",
                  "        if (pm.response.code === 200) pm.expect(body.status).to.eql('PARSED');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/status/{{lowFuelFlightId}}",
              "host": [
                "{{baseUrl}}"

{
  "info": {
    "_postman_id": "30e9fe7f-f499-4bd8-9016-857a6c0243d6",
    "name": "POS Report Pipeline",
    "description": "Aircraft position report pipeline.\n\nTwo endpoints:\n- POST /pos-reports    submit a raw POS report (text/plain)\n- GET  /status/{flightId}   latest known state\n\nIMPORTANT: a report carries a day but no year or month, so the flight ID takes those from when the request arrives. `041205` becomes `...YYYYMM04...` for the current month. The requests below build that date at run time, and the POST saves the returned flightId into the `flightId` collection variable, so run POST before GET.\n\nThe pipeline is asynchronous. A status lookup in the first second or two legitimately returns 404 or PARSED. 'Get status' retries automatically when run in the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Flight IDs embed the current year and month.",
          "const now = new Date();",
          "const ym = now.getUTCFullYear().toString() +",
          "           String(now.getUTCMonth() + 1).padStart(2, '0');",
          "pm.collectionVariables.set('ym', ym);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://bjuqwggytj.execute-api.ap-southeast-1.amazonaws.com/prod",
      "type": "string"
    },
    {
      "key": "flightId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ym",
      "value": "",
      "type": "string"
    },
    {
      "key": "statusRetries",
      "value": "0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Happy path",
      "description": "The worked example from the brief: 43 minutes remaining, 10513 kg at arrival.",
      "item": [
        {
          "name": "Submit report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('status is RECEIVED', () => pm.expect(body.status).to.eql('RECEIVED'));",
                  "pm.test('flightId is UL204 + this month + 04 + RGN + BKK', () => {",
                  "    pm.expect(body.flightId).to.eql('UL204' + pm.collectionVariables.get('ym') + '04RGNBKK');",
                  "});",
                  "",
                  "// Hand the id to the next request.",
                  "pm.collectionVariables.set('flightId', body.flightId);",
                  "pm.collectionVariables.set('statusRetries', '0');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "POS/UL204.FR RGN/TO BKK/041205/N1642.3E09612.5/450/12500/2800",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/pos-reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pos-reports"
              ]
            },
            "description": "Body is the raw POS report as text/plain."
          }
        },
        {
          "name": "Get status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const retries = parseInt(pm.collectionVariables.get('statusRetries') || '0', 10);",
                  "const body = pm.response.code === 200 ? pm.response.json() : {};",
                  "",
                  "// The pipeline is asynchronous: 404 or PARSED just means it has not",
                  "// caught up yet. Retry a bounded number of times in the Runner.",
                  "if (body.status !== 'CALCULATED' && retries < 10) {",
                  "    pm.collectionVariables.set('statusRetries', String(retries + 1));",
                  "    postman.setNextRequest('Get status');",
                  "} else {",
                  "    pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "    pm.test('reached CALCULATED', () => pm.expect(body.status).to.eql('CALCULATED'));",
                  "    pm.test('43 minutes remaining', () => pm.expect(body.remainingFlightTimeMinutes).to.eql(43));",
                  "    pm.test('10513 kg at arrival', () => pm.expect(body.estimatedFuelAtArrivalKg).to.eql(10513));",
                  "    pm.test('no low fuel warning', () => pm.expect(body.lowFuelWarning).to.eql(false));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/status/{{flightId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "status",
                "{{flightId}}"
              ]
            },
            "description": "Returns CALCULATED once the calculator has run; PARSED or 404 before that."
          }
        }
      ]
    },
